          "cookie": [],
          "body": "[\n  {\n    \"id\": 1,\n    \"name\": \"Bench Press\",\n    \"muscleGroup\": \"CHEST\",\n    \"instructions\": \"Lie on the bench, lower the bar towards your chest, then press it back up.\"\n  },\n  {\n    \"id\": 2,\n    \"name\": \"Lat Pulldown\",\n    \"muscleGroup\": \"BACK\",\n    \"instructions\": \"Pull the bar towards your upper chest while keeping your torso controlled.\"\n  },\n  {\n    \"id\": 3,\n    \"name\": \"Shoulder Press\",\n    \"muscleGroup\": \"SHOULDERS\",\n    \"instructions\": \"Press the weight overhead until your arms are extended, then lower with control.\"\n  },\n  {\n    \"id\": 4,\n    \"name\": \"Bicep Curl\",\n    \"muscleGroup\": \"BICEPS\",\n    \"instructions\": \"Curl the weight towards your shoulders while keeping your elbows close to your body.\"\n  },\n  {\n    \"id\": 5,\n    \"name\": \"Tricep Pushdown\",\n    \"muscleGroup\": \"TRICEPS\",\n    \"instructions\": \"Push the handle down until your arms are extended, then return with control.\"\n  },\n  {\n    \"id\": 6,\n    \"name\": \"Leg Extension\",\n    \"muscleGroup\": \"LEGS\",\n    \"instructions\": \"Extend your knees until your legs are straight, then lower the weight slowly.\"\n  },\n  {\n    \"id\": 7,\n    \"name\": \"Hip Thrust\",\n    \"muscleGroup\": \"GLUTES\",\n    \"instructions\": \"Rest your upper back against a bench with the barbell across your hips. Drive through your heels and lift your hips until your torso and thighs form a straight line, squeeze your glutes, then lower with control.\"\n  },\n  {\n    \"id\": 8,\n    \"name\": \"Crunch\",\n    \"muscleGroup\": \"CORE\",\n    \"instructions\": \"Lie on your back with knees bent and feet flat. Brace your abs, lift your shoulders and upper back towards your knees, then lower slowly while keeping your lower back on the floor.\"\n  },\n  {\n    \"id\": 9,\n    \"name\": \"Dumbbell Fly\",\n    \"muscleGroup\": \"CHEST\",\n    \"instructions\": \"Keep a slight bend in your elbows, lower the weights out to your sides, then bring them together over your chest.\"\n  },\n  {\n    \"id\": 10,\n    \"name\": \"Push Up\",\n    \"muscleGroup\": \"CHEST\",\n    \"instructions\": \"Start in a high plank with your hands slightly wider than shoulder-width. Lower your chest toward the floor while keeping your body straight, then push back up.\"\n  },\n  {\n    \"id\": 11,\n    \"name\": \"Seated Row\",\n    \"muscleGroup\": \"BACK\",\n    \"instructions\": \"Sit tall with your feet braced and arms extended. Pull the handle toward your lower ribs while drawing your shoulder blades back, then extend your arms with control.\"\n  },\n  {\n    \"id\": 12,\n    \"name\": \"Pull Up\",\n    \"muscleGroup\": \"BACK\",\n    \"instructions\": \"Pull your body up until your chin clears the bar, then lower with control.\"\n  },\n  {\n    \"id\": 13,\n    \"name\": \"Lateral Raise\",\n    \"muscleGroup\": \"SHOULDERS\",\n    \"instructions\": \"Raise the weights out to your sides to shoulder height, then lower with control.\"\n  },\n  {\n    \"id\": 14,\n    \"name\": \"Front Raise\",\n    \"muscleGroup\": \"SHOULDERS\",\n    \"instructions\": \"Raise the weights in front of you to shoulder height, then lower with control.\"\n  },\n  {\n    \"id\": 15,\n    \"name\": \"Hammer Curl\",\n    \"muscleGroup\": \"BICEPS\",\n    \"instructions\": \"Curl the weights up with your palms facing inward, then lower with control.\"\n  },\n  {\n    \"id\": 16,\n    \"name\": \"Cable Curl\",\n    \"muscleGroup\": \"BICEPS\",\n    \"instructions\": \"Curl the cable toward your shoulders, then return with control.\"\n  },\n  {\n    \"id\": 17,\n    \"name\": \"Tricep Dip\",\n    \"muscleGroup\": \"TRICEPS\",\n    \"instructions\": \"Place your hands on the edge of a bench behind you and move your hips just off the bench. Bend your elbows to lower your body, then press through your hands to return to the start.\"\n  },\n  {\n    \"id\": 18,\n    \"name\": \"Tricep Extension\",\n    \"muscleGroup\": \"TRICEPS\",\n    \"instructions\": \"Hold the dumbbell overhead, bend your elbows to lower it behind your head, then extend your arms back up.\"\n  },\n  {\n    \"id\": 19,\n    \"name\": \"Barbell Squat\",\n    \"muscleGroup\": \"LEGS\",\n    \"instructions\": \"Rest the bar across your upper back, bend your knees and push your hips back until your thighs are around parallel to the floor, then drive through your feet to stand.\"\n  },\n  {\n    \"id\": 20,\n    \"name\": \"Dumbbell Lunge\",\n    \"muscleGroup\": \"LEGS\",\n    \"instructions\": \"Hold a dumbbell in each hand, step forward and lower until your front thigh is around parallel to the floor, then push through your front foot to return to standing.\"\n  },\n  {\n    \"id\": 21,\n    \"name\": \"Glute Bridge\",\n    \"muscleGroup\": \"GLUTES\",\n    \"instructions\": \"Lie on your back with your knees bent and feet flat. Drive through your heels, squeeze your glutes and lift your hips until your body forms a straight line from your shoulders to your knees, then lower with control.\"\n  },\n  {\n    \"id\": 22,\n    \"name\": \"Cable Kickback\",\n    \"muscleGroup\": \"GLUTES\",\n    \"instructions\": \"Extend one leg behind you while keeping your hips steady, then return with control.\"\n  },\n  {\n    \"id\": 23,\n    \"name\": \"Plank\",\n    \"muscleGroup\": \"CORE\",\n    \"instructions\": \"Lie face down on the floor. Balance yourself on your forearms and toes, keeping your shoulders and buttocks at the same height. Hold this position for the desired length of time while contracting your abs.\"\n  },\n  {\n    \"id\": 24,\n    \"name\": \"Bicycle Crunch\",\n    \"muscleGroup\": \"CORE\",\n    \"instructions\": \"Bring one knee toward your chest while rotating your torso toward it, then alternate sides.\"\n  }\n]"
